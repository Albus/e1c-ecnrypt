#Область ПрограммныйИнтерфейс

// Вычисление хеш-суммы переданных данных с использованием алгоритма PBKDF2-SHA256.
// Может применяться для контроля целостности или получения ключей.
// 
// Параметры:
//  Данные - Строка, ДвоичныеДанные - данные для хеширования. Не могут быть пустыми.
// 
// Возвращаемое значение:
//  ДвоичныеДанные - хеш-сумма.
//
Функция Хеш(Знач Данные) Экспорт
	
	~Начало:
	
	// Проверка на непустое значение
	Если Не ЗначениеЗаполнено(Данные) Тогда
		ВызватьИсключение "Генератор хеша принимает параметром только не пустое значение";
	КонецЕсли;
	
	Если ТипЗнч(Данные) = Тип("Строка") Тогда
		Если ЭтоАдресВременногоХранилища(Данные) Тогда
			Данные = ПолучитьИзВременногоХранилища(Данные);
			Перейти ~Начало;
		КонецЕсли;
	КонецЕсли;
	
	// Проверка допустимого типа: строка или двоичные данные
	ДопустимыеТипыДанных = Новый ОписаниеТипов("Строка,ДвоичныеДанные");
	Если Не ДопустимыеТипыДанных.СодержитТип(ТипЗнч(Данные)) Тогда
		ВызватьИсключение "Генератор хеша принимает параметром только значение типов Строка|ДвоичныеДанные";
	КонецЕсли;
	
	ХД = Новый ХешированиеДанных(ХешФункция.PBKDF2SHA256);
	ХД.Добавить(Данные);

	Возврат ХД.ХешСумма;
КонецФункции

// Формирует криптографический ключ для последующего использования в функции Обработать.
// Ключ вычисляется на основе переданного уникального идентификатора объекта метаданных
// с применением криптостойких преобразований (PBKDF2-SHA256 от вычисленной соли).
// 
// Параметры:
//  УИД - УникальныйИдентификатор - уникальный идентификатор, используемый как соль для ключа.
//         Должен быть непустым.
// 
// Возвращаемое значение:
//  ДвоичныеДанные - ключ шифрования.
//
Функция Ключ(УИД) Экспорт
	
	// Валидация входного параметра: должен быть заполненный УникальныйИдентификатор
	Если Не ТипЗнч(УИД) = Тип("УникальныйИдентификатор")
		Или Не ЗначениеЗаполнено(УИД) Тогда
		ВызватьИсключение "Генератор ключа шифрования принимает параметром только значение типа УникальныйИдентификатор";
	КонецЕсли;
	
	// Генерация соли на основе УИД, а затем хеширование для получения ключа
	Возврат ШифрованиеВызовСервераПовтИсп.Хеш(ШифрованиеКлиентСервер.Соль(УИД));
КонецФункции

// Есть право на шифрование.
// 
// Возвращаемое значение:
//  Булево - Есть право на шифрование
//
Функция ЕстьПравоНаШифрование() Экспорт
	Возврат РольДоступна("ЧтениеКлючейШифрования");
КонецФункции

#КонецОбласти