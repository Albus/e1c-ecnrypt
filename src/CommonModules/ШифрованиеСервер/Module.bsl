#Область СлужебныйПрограммныйИнтерфейс

// Обработать ДвоичныеДанные.
// 
// Параметры:
//  Данные - ДвоичныеДанные - адрес временного хранилища
//  УИД - УникальныйИдентификатор - ключ шифрования
// 
// Возвращаемое значение:
//  ДвоичныеДанные - данные
Функция ОбработатьДвоичныеДанные(Данные, УИД) Экспорт
	Возврат ГенерироватьКлючОбработать(Данные, УИД);
КонецФункции

// Обработать адрес временного хранилища.
// 
// Параметры:
//  Адрес - Строка - адрес временного хранилища
//  УИД - УникальныйИдентификатор - ключ шифрования
// 
// Возвращаемое значение:
//  Строка - адрес временного хранилища
Функция ОбработатьАдресВременногоХранилища(Адрес, УИД) Экспорт
	Если Не ТипЗнч(Адрес) = Тип("Строка") Тогда
		ВызватьИсключение "Ожидается Строка";
	ИначеЕсли ПустаяСтрока(Адрес) Тогда
		ВызватьИсключение "Ожидается не пустая Строка";
	ИначеЕсли Не ЭтоАдресВременногоХранилища(Адрес) Тогда
		ВызватьИсключение "Ожидается адрес временного хранилища";
	КонецЕсли;

	Данные = ПолучитьИзВременногоХранилища(Адрес); // ДвоичныеДанные
	Возврат ПоместитьВоВременноеХранилище(ОбработатьДвоичныеДанные(Данные, УИД));
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выполняет симметричную криптографическую обработку переданных двоичных данных алгоритмом RC4.
// Одна и та же функция используется как для зашифрования, так и для расшифрования:
// повторный вызов с тем же ключом восстанавливает исходные данные.
// 
// Параметры:
//  Данные - ДвоичныеДанные - открытый текст или шифротекст
//  Ключ - ДвоичныеДанные - секретный ключ.
//  
// Возвращаемое значение:
//  ДвоичныеДанные - результат операции.
//
Функция Обработать(Данные, Ключ)

	Если Не ТипЗнч(Данные) = Тип("ДвоичныеДанные") Или Не ТипЗнч(Ключ) = Тип("ДвоичныеДанные") Тогда
		ВызватьИсключение "Ожидаются ДвоичныеДанные";

	ИначеЕсли Не ЗначениеЗаполнено(Данные) Или Не ЗначениеЗаполнено(Ключ) Тогда
		ВызватьИсключение "Ожидаются не пустые ДвоичныеДанные";

	КонецЕсли;

	// --- Подготовка буферов ---
	//@skip-check invocation-parameter-type-intersect
	Буфер = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Данные);
	КлючБуфер = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Ключ);
	РазмерКлюча = КлючБуфер.Размер;  // однократное вычисление длины ключа
	
	// --- Инициализация S-блока (Key Scheduling Algorithm, KSA) ---
	S = Новый Массив(256);
	Для i = 0 По 255 Цикл
		S[i] = i;   // начальное заполнение 0..255
	КонецЦикла;

	j = 0;
	Для i = 0 По 255 Цикл
		// Перемешивание S на основе ключа
		j = (j + S[i] + КлючБуфер.Получить(i % РазмерКлюча)) % 256;
		// Обмен S[i] и S[j]
		t = S[i];
		S[i] = S[j];
		S[j] = t;
	КонецЦикла;
	
	// --- Генерация псевдослучайной гаммы и наложение на данные (PRGA) ---
	i = 0;
	j = 0;
	РазмерДанных = Буфер.Размер;
	Для p = 0 По РазмерДанных - 1 Цикл
		// Обновление индексов
		i = (i + 1) % 256;
		j = (j + S[i]) % 256;
		
		// Обмен S[i] и S[j]
		t = S[i];
		S[i] = S[j];
		S[j] = t;
		
		// Вычисление байта гаммы (K) и XOR с исходным байтом
		ИндексГаммы = (S[i] + S[j]) % 256;
		БайтГаммы = S[ИндексГаммы];
		//@skip-check invocation-parameter-type-intersect
		Буфер.Установить(p, ПобитовоеИсключительноеИли(Буфер.Получить(p), БайтГаммы));
	КонецЦикла;

	Возврат ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Буфер);
КонецФункции

// Преобразует GUID в «инверсную» hex-строку.
// Алгоритм: из строки GUID убираются дефисы, а затем байты переставляются в обратном порядке
// (группировка для получения «инверсного» представления, обратного стандартному порядку байт).
// 
// Параметры:
//  УИД - УникальныйИдентификатор - исходный GUID.
// 
// Возвращаемое значение:
//  Строка - 32-символьная hex-строка (16 байт) с переставленными группами.
//
Функция ПолучитьГУИДИнверсныйИзПрямого(УИД)

	С = СтрЗаменить(Строка(УИД), "-", "");
	
	// Перестановка групп: младшие 8 байт, затем следующие 2, затем 2, затем 2, затем старшие 2.
	// Порядок: байты 16-31, 12-15, 8-11, 0-7, 4-7? Согласно коду:
	// Сред(С,17,16) – последние 16 символов (байты 8-15)
	// Сред(С,13,4)  – байты 6-7
	// Сред(С,9,4)   – байты 4-5
	// Сред(С,1,4)   – байты 0-1
	// Сред(С,5,4)   – байты 2-3
	Возврат Сред(С, 17, 16) + Сред(С, 13, 4) + Сред(С, 9, 4) + Сред(С, 1, 4) + Сред(С, 5, 4);
КонецФункции

// Получение соли из уникального идентификатора.
// Используется детерминированное преобразование: создаётся UUID версии 5 на основе
// исходного GUID и его «инверсного» представления, затем результат инвертируется.
// Это гарантирует уникальную и постоянную соль для каждого объекта метаданных.
// 
// Параметры:
//  УИД - УникальныйИдентификатор - основание для вычисления соли.
// 
// Возвращаемое значение:
//  ДвоичныеДанные - соль длиной 16 байт.
//
Функция Соль(УИД)
	
	// Проверка прав доступа: только пользователи с ролью "ЧтениеКлючейШифрования"
	// могут получать соль и, соответственно, ключи шифрования.
	Если Не ШифрованиеВызовСервераПовтИсп.ЕстьПравоНаШифрование() Тогда
		ВызватьИсключение "Нет прав для чтения ключей шифрования (роль: ЧтениеКлючейШифрования)";
	КонецЕсли;
	
	// Получаем инверсный GUID от исходного УИД
	ИнверсныйУИД = ПолучитьГУИДИнверсныйИзПрямого(УИД);
	
	// Формируем UUID версии 5, используя исходный GUID в качестве namespace,
	// а инверсный GUID — в качестве имени.
	УИД5 = Новый УникальныйИдентификатор(ВерсияУникальногоИдентификатора.Версия5, УИД, ИнверсныйУИД);
	
	// Инвертируем полученный UUID и преобразуем в двоичные данные (16 байт)
	Возврат ПолучитьДвоичныеДанныеИзHexСтроки(ПолучитьГУИДИнверсныйИзПрямого(УИД5));
КонецФункции

// Формирует криптографический ключ для последующего использования в функции Обработать.
// Ключ вычисляется на основе переданного уникального идентификатора объекта метаданных
// с применением криптостойких преобразований (PBKDF2-SHA256 от вычисленной соли).
// 
// Параметры:
//  УИД - УникальныйИдентификатор - уникальный идентификатор, используемый как соль для ключа.
//         Должен быть непустым.
// 
// Возвращаемое значение:
//  ДвоичныеДанные - ключ шифрования.
//
Функция Ключ(УИД)
	
	// Валидация входного параметра: должен быть заполненный УникальныйИдентификатор
	Если Не ТипЗнч(УИД) = Тип("УникальныйИдентификатор") Или Не ЗначениеЗаполнено(УИД) Тогда
		ВызватьИсключение "Генератор ключа шифрования принимает параметром только значение типа УникальныйИдентификатор";
	КонецЕсли;
	
	// Генерация соли на основе УИД, а затем хеширование для получения ключа
	ХД = Новый ХешированиеДанных(ХешФункция.PBKDF2SHA256);
	ХД.Добавить(Соль(УИД));

	Возврат ХД.ХешСумма;
КонецФункции

// Выполняет симметричную криптографическую обработку переданных двоичных данных алгоритмом RC4.
// Одна и та же функция используется как для зашифрования, так и для расшифрования:
// повторный вызов с тем же ключом восстанавливает исходные данные.
// 
// Параметры:
//  Данные - ДвоичныеДанные - открытый текст или шифротекст
//  УИД - УникальныйИдентификатор - ключ.
//  
// Возвращаемое значение:
//  ДвоичныеДанные - результат операции.
//
Функция ГенерироватьКлючОбработать(Данные, УИД)
	Если Не ТипЗнч(УИД) = Тип("УникальныйИдентификатор") Тогда
		ВызватьИсключение "Ожидается УникальныйИдентификатор";
	ИначеЕсли Не ЗначениеЗаполнено(УИД) Тогда
		ВызватьИсключение "Ожидаются не пустой УникальныйИдентификатор";
	КонецЕсли;
	Возврат Обработать(Данные, Ключ(УИД));
КонецФункции

#КонецОбласти